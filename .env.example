# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# Optional. YouTube Data API v3 key, used to check demand for Studio ideas.
# Free: Google Cloud console > new project > enable "YouTube Data API v3" > Credentials > API key.
YOUTUBE_API_KEY=

# Optional. A URL or email of yours, sent to Wikimedia (and nowhere else) in the User-Agent of archive
# photo searches. Wikimedia allows 200 searches a minute to an app that names a contact, 10 without.
WIKIMEDIA_CONTACT=

# Optional. ElevenLabs key for the paid AI voice. Kokoro, the free voice, needs nothing.
ELEVENLABS_API_KEY=

# Optional. Your Claude subscription instead of the API, for the tiers set to "Claude plan (CLI)" under
# Settings > AI models. On your Mac the Claude CLI's own login is used and this stays empty. In Docker or
# on a server: run `claude setup-token` on your computer and paste the token it prints here.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional. OpenAI, when a tier under Settings > AI models uses it.
OPENAI_API_KEY=
# Optional. Any OpenAI-compatible server instead of OpenAI (OpenRouter, a local Ollama...).
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Optional. Scheduling approved Shorts on Instagram and TikTok through Buffer (README, "Scheduling Shorts").
# Buffer > Settings > API > create a key.
BUFFER_API_KEY=
# The Cloudflare R2 bucket Buffer fetches the videos from (Buffer has no upload of its own).
# Account ID: Cloudflare dashboard > R2 > Overview. Keys: R2 > API Tokens > "Object Read & Write" on the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# The bucket's public address: Settings > Public Development URL (https://pub-....r2.dev), or a custom domain.
R2_PUBLIC_URL=
# Only for a bucket created in a jurisdiction, for example the EU:
# R2_ENDPOINT=https://<account id>.eu.r2.cloudflarestorage.com

# --- Docker only, all optional ---
# CLIPPER_PORT=8000
# CLIPPER_DATA=./data
# CLIPPER_OUTPUT=/mnt/bigdisk/clips
# CLIPPER_VIDEOS=./videos
# POSTGRES_PASSWORD=change-me
